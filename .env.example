# ---------------------------------------------------------------
# DAX AI Financial Reporter — environment variables
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------

# --- Required ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Report output ---
REPORT_OUTPUT_DIR=output/reports
REPORT_FORMAT=markdown          # markdown | html

# --- WhatsApp via Twilio (optional) ---
# Sign up at https://www.twilio.com (free sandbox available)
# Sandbox number is always: whatsapp:+14155238886
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+49170xxxxxxx   # your own WhatsApp number with country code
