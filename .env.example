# ---------------------------------------------------------------
# DAX AI Financial Reporter — environment variables
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------

# --- Report output ---
REPORT_OUTPUT_DIR=output/reports
REPORT_FORMAT=markdown

# --- WhatsApp via Twilio ---
# Secrets (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN) must be set in your OS environment (~/.zshrc)
# export TWILIO_ACCOUNT_SID=ACxxxxxxx...
# export TWILIO_AUTH_TOKEN=your_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+49170xxxxxxx
